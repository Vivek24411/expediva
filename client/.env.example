# ---------------------------------------------------------------------------
# Expediva client — copy to .env.local and fill in.
# Vite only exposes variables prefixed with VITE_ to the browser.
# Never put secrets here: everything in this file ships in the JS bundle.
# ---------------------------------------------------------------------------

# Base URL of the Expediva API (no trailing slash).
# Local:      http://localhost:4000
# Production: https://expediva-api.onrender.com
VITE_API_URL=http://localhost:4000

# Canonical public URL of this site — used for canonical links, OG tags and JSON-LD.
VITE_SITE_URL=http://localhost:5173
