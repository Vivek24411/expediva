{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "https://expediva-api.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://expediva-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/((?!assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
