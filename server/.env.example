# ---------------------------------------------------------------------------
# Expediva API — copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# --- MongoDB Atlas ---------------------------------------------------------
# Atlas → Database → Connect → Drivers. Replace <password> and add the db name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/expediva?retryWrites=true&w=majority

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-16-chars
JWT_EXPIRES_IN=7d

# --- CORS / links ----------------------------------------------------------
# Browser origin(s) allowed to call this API. Comma-separate for previews.
# Production example: https://expediva.vercel.app,https://www.expediva.in
CLIENT_ORIGIN=http://localhost:5173

# Public site URL — used to build sitemap.xml and robots.txt entries.
PUBLIC_SITE_URL=http://localhost:5173

# --- Cloudinary ------------------------------------------------------------
# Cloudinary dashboard → Product Environment Credentials.
# Leave blank in dev: /api/upload returns 503 instead of crashing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=expediva

# --- Admin seed credentials -------------------------------------------------
# `npm run seed` upserts this account. Change the password before going live.
ADMIN_EMAIL=admin@expediva.in
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Expediva Admin
